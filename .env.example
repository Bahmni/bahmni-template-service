# Port the service listens on
PORT=8080
# Base URL for OpenMRS (used for FHIR/REST API calls)
OPENMRS_URL=http://localhost:8080
# Timeout in milliseconds for OpenMRS API requests
OPENMRS_TIMEOUT_MS=10000
# Directory path where print templates are stored
TEMPLATES_DIR=/etc/bahmni_config/print-templates
# Logging level (debug, info, warn, error)
LOG_LEVEL=debug
# Set to true to enable PDF generation via Playwright/Chromium
PDF_ENABLED=false
# Maximum number of concurrent PDF generation requests
MAX_CONCURRENT_PDF=2
# Set to true to cache Nunjucks templates (recommended for production; false for development)
NUNJUCKS_CACHE=false
